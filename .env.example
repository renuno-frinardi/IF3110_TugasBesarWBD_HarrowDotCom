# PostgreSQL
POSTGRES_DB=harrow_db
POSTGRES_USER=harrow
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5433

# Go app
DATABASE_URL=postgresql://harrow:change-this-postgres-password@localhost:5433/harrow_db
ENCRYPTION_KEY=

# PostgreSQL variables
PGHOST=localhost
PGPORT=5433
PGDATABASE=harrow_db
PGUSER=harrow
PGPASSWORD=change-this-postgres-password

# MariaDB bonus
MARIADB_DATABASE=harrow_db
MARIADB_USER=harrow
MARIADB_PASSWORD=change-this-mariadb-password
MARIADB_ROOT_PASSWORD=change-this-mariadb-root-password
MARIADB_PORT=3306
