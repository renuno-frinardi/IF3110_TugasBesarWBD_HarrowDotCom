# PostgreSQL
POSTGRES_DB=harrow_db
POSTGRES_USER=harrow
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5433

# Go app
APP_PORT=8080
FRONTEND_PORT=5173
DATABASE_URL=postgresql://harrow:change-this-postgres-password@localhost:5433/harrow_db
TEST_DATABASE_URL=postgresql://harrow:change-this-postgres-password@localhost:5433/harrow_db_test
ENCRYPTION_KEY=

# Async worker & Observability
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_TTL_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_MS=500
OTEL_EXPORTER=stdout

# PostgreSQL variables
PGHOST=localhost
PGPORT=5433
PGDATABASE=harrow_db
PGUSER=harrow
PGPASSWORD=change-this-postgres-password

# MariaDB bonus
MARIADB_DATABASE=harrow_db
MARIADB_USER=harrow
MARIADB_PASSWORD=change-this-mariadb-password
MARIADB_ROOT_PASSWORD=change-this-mariadb-root-password
MARIADB_PORT=3307