# Application & Frontend
APP_PORT=8080
FRONTEND_PORT=5173
ENCRYPTION_KEY=

# Session & Initial Admin Seeding
SESSION_COOKIE_NAME=harrow_session
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATION_INTERVAL=10m
SESSION_GRACE_PERIOD=30s
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-admin-password

# Platform PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=harrow_db
POSTGRES_TEST_DB=harrow_db_test
POSTGRES_USER=harrow
POSTGRES_PASSWORD=change-this-postgres-password

# Async Worker
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_TTL_SECONDS=15
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_MS=500

# Target Database Load-Test (commerce-db)
COMMERCE_DB_HOST=localhost
COMMERCE_DB_PORT=5434
COMMERCE_DB_NAME=harrow_commerce
COMMERCE_DB_USER=commerce_admin
COMMERCE_DB_PASSWORD=change-this-commerce-password

# MariaDB Target (Optional Profile)
MARIADB_HOST=localhost
MARIADB_PORT=3307
MARIADB_DATABASE=harrow_mariadb
MARIADB_TEST_DATABASE=harrow_mariadb_test
MARIADB_USER=harrow_maria
MARIADB_PASSWORD=change-this-mariadb-password
MARIADB_ROOT_PASSWORD=change-this-mariadb-root-password

# k6 Stress Testing
K6_CASE=same_database
K6_NORMAL_VUS=2
K6_STAGE_SECONDS=30
K6_USERNAME=akun-test
K6_PASSWORD=change-this-k6-password